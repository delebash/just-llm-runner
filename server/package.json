{
  "name": "@delebash/llm-runner",
  "version": "0.1.0",
  "private": true,
  "description": "The family's shared server kit in JavaScript — the LLM stack (providers, routing, presets, prompts, usage), the bundled llama.cpp runner and the platform pieces (errors, the spawn door, the data folder, backup). Mounted by each app's Fastify server with installLlm. The JavaScript port of llm_runner (docs: JustVoice docs/plans/2026-10-07-electron-node-plan.md §4).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/index.js",
    "./llm": "./src/llm/index.js",
    "./platform": "./src/platform/index.js",
    "./llm/*": "./src/llm/*.js",
    "./runner/*": "./src/runner/*.js",
    "./platform/*": "./src/platform/*.js",
    "./shell": "./src/shell/main.js",
    "./shell/preload": "./src/shell/preload.cjs",
    "./shell/*": "./src/shell/*.js"
  },
  "scripts": {
    "test": "node scripts/node24.mjs node_modules/vitest/vitest.mjs run",
    "test:watch": "node scripts/node24.mjs node_modules/vitest/vitest.mjs",
    "lint": "biome check src tests scripts",
    "schema": "node scripts/capture-schema.mjs"
  },
  "allowScripts": {
    "electron": true,
    "koffi": true,
    "better-sqlite3": true
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/multipart": "^10.1.2",
    "@google/genai": "^2.28.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "koffi": "^3.3.2",
    "openai": "^7.30.0",
    "typebox": "^1.3.34",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "electron": "44.7.0",
    "vitest": "^4.1.11"
  }
}
